{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run app (manual testing)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.main",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Run all tests + HTML report",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["--html=report.html", "--self-contained-html"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "Run UI tests (watch the browser)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-m", "ui", "--headed"],
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
